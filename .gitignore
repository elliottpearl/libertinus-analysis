# Virtual environment
.venv/
.venv-fontforge/

# Python cache
__pycache__/
*.pyc

# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.synctex.gz

# VS Code settings (optional)
.vscode/

# pip cruft
*.egg-info/
# Brill fonts: Brill EULA forbids redistribution (non-commercial use only).
# Keep the fonts, and anything built from them (patches, drafts, ttx dumps), out of git.
fonts/Brill*
**/Brill*.otf
**/Brill*.ttf
**/Brill*.woff
**/Brill*.woff2
**/Brill*.ttx

# Windows download markers and downloaded archives
*:Zone.Identifier
fonts/*.zip
