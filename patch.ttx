      <map code="0xab52" name="uniAB52"/><!-- LATIN SMALL LETTER U WITH LEFT HOOK -->
      <map code="0xfffd" name="uniFFFD"/><!-- REPLACEMENT CHARACTER -->
      <map code="0x1f12f" name="u1F12F"/><!-- COPYLEFT SYMBOL -->
